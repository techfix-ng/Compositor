<Window x:Class="Compositor.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Compositor for Windows" Width="1440" Height="900" MinWidth="1000" MinHeight="650" Background="#111214" Foreground="#F4F4F5" WindowStartupLocation="CenterScreen">
 <DockPanel><Menu DockPanel.Dock="Top" Background="#17181A"><MenuItem Header="_File"><MenuItem Header="_Open…" Click="Open_Click"/><Separator/><MenuItem Header="E_xit" Click="Exit_Click"/></MenuItem><MenuItem Header="_Edit"/><MenuItem Header="_Image"/><MenuItem Header="_Layer"/><MenuItem Header="_Select"/><MenuItem Header="_Filter"/><MenuItem Header="_View"/></Menu>
 <StatusBar DockPanel.Dock="Bottom" Background="#17181A"><TextBlock x:Name="StatusText" Text="Ready"/></StatusBar>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
 <StackPanel Grid.Column="0" Background="#202124" Margin="0"><Button Content="↖" ToolTip="Move" Height="44" Margin="8,10,8,2"/><Button Content="▧" ToolTip="Selection" Height="44" Margin="8,2"/><Button Content="✎" ToolTip="Brush" Height="44" Margin="8,2"/><Button Content="T" ToolTip="Text" Height="44" Margin="8,2"/></StackPanel>
 <Border Grid.Column="1" Background="#2A2B2E" Padding="24"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid><Border x:Name="EmptyState" Background="#1B1C1F" Width="560" Height="330" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10"><StackPanel VerticalAlignment="Center"><TextBlock Text="Compositor" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Native Windows edition" Foreground="#AEB1B7" FontSize="16" Margin="0,8,0,24" HorizontalAlignment="Center"/><Button Content="Open an image" Width="150" Height="38" Click="Open_Click"/></StackPanel></Border><Image x:Name="CanvasImage" Stretch="None"/></Grid></ScrollViewer></Border>
 <DockPanel Grid.Column="2" Background="#202124"><TextBlock DockPanel.Dock="Top" Text="LAYERS" FontWeight="SemiBold" Margin="16"/><ListBox x:Name="LayersList" Background="Transparent" Foreground="#F4F4F5" BorderThickness="0"/></DockPanel></Grid></DockPanel>
</Window>
