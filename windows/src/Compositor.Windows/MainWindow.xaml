<Window x:Class="Compositor.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Compositor for Windows" Width="1440" Height="900" MinWidth="1000" MinHeight="650" Background="#111214" Foreground="#F4F4F5" WindowStartupLocation="CenterScreen">
 <DockPanel><Menu DockPanel.Dock="Top" Background="#17181A"><MenuItem Header="_File"><MenuItem Header="_New"/><MenuItem Header="_Open…" Click="Open_Click"/><MenuItem Header="_Save"/><MenuItem Header="Save _As…"/><Separator/><MenuItem Header="_Export…"/><Separator/><MenuItem Header="E_xit" Click="Exit_Click"/></MenuItem><MenuItem Header="_Edit"><MenuItem Header="_Undo"/><MenuItem Header="_Redo"/><Separator/><MenuItem Header="Cu_t"/><MenuItem Header="_Copy"/><MenuItem Header="_Paste"/></MenuItem><MenuItem Header="_Image"><MenuItem Header="Image Size…"/><MenuItem Header="Canvas Size…"/><Separator/><MenuItem Header="Adjustments"/></MenuItem><MenuItem Header="_Layer"><MenuItem Header="New Layer"/><MenuItem Header="New Group"/><MenuItem Header="Duplicate Layer"/><MenuItem Header="Add Layer Mask"/><MenuItem Header="New Adjustment Layer"/></MenuItem><MenuItem Header="_Type"><MenuItem Header="Character"/><MenuItem Header="Paragraph"/><MenuItem Header="Resolve Missing Fonts…"/></MenuItem><MenuItem Header="_Select"/><MenuItem Header="_Filter"/><MenuItem Header="_View"/><MenuItem Header="_Window"/><MenuItem Header="_Help"/></Menu>
 <Border DockPanel.Dock="Top" Height="48" Background="#202124" BorderBrush="#34363A" BorderThickness="0,0,0,1">
  <DockPanel Margin="14,7"><TextBlock x:Name="OptionsTitle" DockPanel.Dock="Left" Width="130" Text="Move / Transform" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Fit" Width="52" Margin="3,0" Click="Fit_Click"/><Button Content="100%" Width="52" Margin="3,0" Click="ActualPixels_Click"/><Button Content="−" Width="38" Margin="3,0" Click="ZoomOut_Click"/><Button Content="+" Width="38" Margin="3,0" Click="ZoomIn_Click"/></StackPanel><StackPanel x:Name="TypeOptions" Visibility="Collapsed" Orientation="Horizontal"><ComboBox x:Name="FontFamilyBox" Width="210" SelectionChanged="TextFormat_Changed"/><ComboBox x:Name="FontSizeBox" Width="72" Margin="6,0" IsEditable="True" Text="32" SelectionChanged="TextFormat_Changed"><ComboBoxItem Content="12"/><ComboBoxItem Content="18"/><ComboBoxItem Content="24"/><ComboBoxItem Content="32"/><ComboBoxItem Content="48"/><ComboBoxItem Content="72"/></ComboBox><Button Content="L" Width="34" Click="AlignLeft_Click"/><Button Content="C" Width="34" Click="AlignCenter_Click"/><Button Content="R" Width="34" Click="AlignRight_Click"/><Button x:Name="TextColorButton" Content="■" Foreground="White" Width="38" Click="TextColor_Click"/></StackPanel></DockPanel>
 </Border>
 <StatusBar DockPanel.Dock="Bottom" Background="#17181A"><TextBlock x:Name="StatusText" Text="Ready"/></StatusBar>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
 <ScrollViewer Grid.Column="0" Background="#202124" VerticalScrollBarVisibility="Hidden"><StackPanel Margin="8,6">
  <Button Content="↖" Tag="Move / Transform" ToolTip="Move / Transform (V)" Height="38" Click="Tool_Click"/>
  <Button Content="▧" Tag="Marquee" ToolTip="Marquee (M)" Height="38" Click="Tool_Click"/>
  <Button Content="➰" Tag="Lasso" ToolTip="Lasso (L)" Height="38" Click="Tool_Click"/>
  <Button Content="✦" Tag="Magic Wand" ToolTip="Magic Wand (W)" Height="38" Click="Tool_Click"/>
  <Button Content="⌗" Tag="Crop" ToolTip="Crop (C)" Height="38" Click="Tool_Click"/>
  <Button Content="✎" Tag="Brush / Eraser" ToolTip="Brush / Eraser (B/E)" Height="38" Click="Tool_Click"/>
  <Button Content="✚" Tag="Spot Healing" ToolTip="Spot Healing (J)" Height="38" Click="Tool_Click"/>
  <Button Content="♟" Tag="Clone Stamp" ToolTip="Clone Stamp (S)" Height="38" Click="Tool_Click"/>
  <Button Content="●" Tag="Blur / Smear" ToolTip="Blur / Smear (R)" Height="38" Click="Tool_Click"/>
  <Button Content="◩" Tag="Gradient" ToolTip="Gradient (G)" Height="38" Click="Tool_Click"/>
  <Button Content="▢" Tag="Shape" ToolTip="Shape (U)" Height="38" Click="Tool_Click"/>
  <Button Content="⚗" Tag="Eyedropper" ToolTip="Eyedropper (I)" Height="38" Click="Tool_Click"/>
  <Button Content="T" Tag="Type" ToolTip="Type (T)" Height="38" Click="Tool_Click"/>
  <Button Content="✋" Tag="Hand / Pan" ToolTip="Hand / Pan (H)" Height="38" Click="Tool_Click"/>
  <Button Content="⌕" Tag="Zoom" ToolTip="Zoom (Z)" Height="38" Click="Tool_Click"/>
 </StackPanel></ScrollViewer>
 <Border Grid.Column="1" Background="#2A2B2E" Padding="24"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid><Border x:Name="EmptyState" Background="#1B1C1F" Width="560" Height="330" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10"><StackPanel VerticalAlignment="Center"><TextBlock Text="Compositor" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Native Windows edition" Foreground="#AEB1B7" FontSize="16" Margin="0,8,0,24" HorizontalAlignment="Center"/><Button Content="Open an image" Width="150" Height="38" Click="Open_Click"/></StackPanel></Border><Image x:Name="CanvasImage" Stretch="None"/><Canvas x:Name="TextCanvas" Background="Transparent" MinWidth="900" MinHeight="650" MouseLeftButtonDown="Canvas_MouseLeftButtonDown"/></Grid></ScrollViewer></Border>
 <DockPanel Grid.Column="2" Background="#202124">
  <StackPanel DockPanel.Dock="Top"><TextBlock Text="LAYERS" FontWeight="SemiBold" Margin="16,14,16,8"/><ComboBox x:Name="BlendModeBox" SelectedIndex="0" Margin="12,0,12,6"><ComboBoxItem Content="Normal"/><ComboBoxItem Content="Multiply"/><ComboBoxItem Content="Screen"/><ComboBoxItem Content="Overlay"/></ComboBox><DockPanel Margin="12,0,12,10"><TextBlock Text="Opacity" VerticalAlignment="Center"/><Slider Minimum="0" Maximum="100" Value="100" Margin="12,0,0,0"/></DockPanel></StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="6"><Button Content="＋" ToolTip="New layer" Width="38"/><Button Content="▣" ToolTip="New group" Width="38"/><Button Content="◐" ToolTip="Adjustment layer" Width="38"/><Button Content="▧" ToolTip="Layer mask" Width="38"/><Button Content="⌫" ToolTip="Delete" Width="38"/></StackPanel>
  <ListBox x:Name="LayersList" Background="Transparent" Foreground="#F4F4F5" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="6,4"><CheckBox IsChecked="{Binding IsVisible}" Margin="0,0,8,0"/><TextBlock Text="{Binding Kind}" Foreground="#92959B" Width="44"/><TextBlock Text="{Binding Name}"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
 </DockPanel></Grid></DockPanel>
</Window>
